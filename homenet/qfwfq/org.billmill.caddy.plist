<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>org.billmill.caddy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/llimllib/bin/caddy</string>
		<string>run</string>
		<string>--config</string><string>/Users/llimllib/.config/caddy/Caddyfile</string>
		<string>--envfile</string><string>/Users/llimllib/.config/caddy/env</string>
	</array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>StandardOutPath</key><string>/Users/llimllib/Library/Logs/caddy.log</string>
	<key>StandardErrorPath</key><string>/Users/llimllib/Library/Logs/caddy.log</string>
</dict>
</plist>
