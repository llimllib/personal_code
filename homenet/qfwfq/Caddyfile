# Internal services on qfwfq. DNS: *.home.billmill.org -> 192.168.68.56 (DigitalOcean)
*.home.billmill.org {
	tls {
		dns digitalocean {env.DO_AUTH_TOKEN}
		resolvers 1.1.1.1
	}

	@jellyfin host jellyfin.home.billmill.org
	handle @jellyfin {
		reverse_proxy localhost:8096
	}

	@grafana host grafana.home.billmill.org
	handle @grafana {
		reverse_proxy localhost:3000
	}

	# Synology DSM, via its Tailscale IP: macOS Local Network privacy blocks
	# the launchd-run caddy from LAN addresses ("no route to host"). DSM's
	# HTTPS port has a self-signed cert, so skip verification rather than send
	# DSM logins over plain HTTP on port 5000
	@shifgrethor host shifgrethor.home.billmill.org
	handle @shifgrethor {
		reverse_proxy https://100.81.92.46:5001 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# unknown subdomains
	handle {
		abort
	}
}
