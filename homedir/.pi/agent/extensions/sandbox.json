{
  "enabled": true,
  "//": "This allows go to access the trustd daemon that it uses to verify certificates: https://github.com/anthropic-experimental/sandbox-runtime/pull/120",
  "enableWeakerNetworkIsolation": true,
  "network": {
    "allowedDomains": [
      "*.amazonaws.com",
      "amazonaws.com",
      "*.anthropic.com",
      "anthropic.com",
      "*.atlassian.net",
      "*.circleci.com",
      "circleci.com",
      "*.clickhouse.com",
      "clickhouse.com",
      "*.crates.io",
      "crates.io",
      "*.datadoghq.com",
      "datadoghq.com",
      "debian.org",
      "*.debian.org",
      "*.hub.docker.com",
      "*.docker.com",
      "docker.com",
      "*.en.dev",
      "api.github.com",
      "github.com",
      "*.githubusercontent.com",
      "golang.org",
      "*.golang.org",
      "storage.googleapis.com",
      "grafana.com",
      "*.grafana.net",
      "*.hashicorp.com",
      "*.jdx.dev",
      "jdx.dev",
      "linear.app",
      "*.linear.app",
      "localhost",
      "nodejs.org",
      "*.nodejs.org",
      "npmjs.org",
      "*.npmjs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "*.rust-lang.org",
      "rust-lang.org",
      "*.slack.com",
      "slack.com",
      "*.terraform.io",
      "*.blob.core.windows.net",
      "*.youtube.com",
      "youtube.com"
    ],
    "deniedDomains": [],
    "allowUnixSockets": ["/tmp", "/private/tmp"],
    "allowLocalBinding": true
  },
  "filesystem": {
    "denyRead": ["~/.gnupg", "~/.ssh", "~/.colima", "~/.config/colima"],
    "allowRead": ["~/.aws"],
    "allowWrite": [
      ".",
      "../main",
      "/tmp",
      "/private/tmp",
      "/var/folders",
      "~/.aws/cli/cache",
      "~/.agent-browser",
      "~/.cache",
      "~/.config",
      "~/.local",
      "~/.npm",
      "~/.rustup",
      "~/go",
      "~/Library/Logs",
      "~/Library/Caches"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.tfstate",
      "*.tfstate.backup",
      "**/.terraform/**",
      "**/terraform.tfstate",
      "**/terraform.tfstate.backup"
    ]
  }
}
